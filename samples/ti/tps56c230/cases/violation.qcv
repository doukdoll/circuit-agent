# Developer-authored partial FB divider based on TI SLVUBJ0B; not an EDA export.
# Only U1 FB/AGND and R4/R6 are represented. See ../provenance.json.
NET : 'VOUT' R4-1
NET : 'FB' U1-14 R4-2 R6-1
NET : 'GND' U1-13 R6-2
COMP: 'TPS56C230RJER' 'U1'
  Explicit Pin: '14' 'FB' 'FB'
  Explicit Pin: '13' 'AGND' 'GND'
COMP: 'R0603' 'R4'
Property: Value=12.0k
  Explicit Pin: '1' '1' 'VOUT'
  Explicit Pin: '2' '2' 'FB'
COMP: 'R0603' 'R6'
Property: Value=10.0k
  Explicit Pin: '1' '1' 'FB'
  Explicit Pin: '2' '2' 'GND'
